# Business OS environment template
# Keep this file limited to variable names and safe example values.
# Never commit credentials, tokens, private keys, or production connection strings.
# The G-003 foundation additionally accepts DATABASE_URL for a standard PostgreSQL
# instance. Later gates own identity, queue, storage, integration, AI, and production configuration.

SERVICE_NAME=business-os
APP_VERSION=0.1.0
PORT=3000
LOG_LEVEL=info

# APP_ENV=development
# APP_LOG_LEVEL=info
DATABASE_URL=postgresql://business_os_app:change-me@127.0.0.1:5432/business_os_development
# Set this to true when the app is embedded in a cross-site HTTPS preview iframe.
# COOKIE_CROSS_SITE=false
# STORAGE_ENDPOINT=
# QUEUE_ENDPOINT=
# EXTERNAL_PROVIDER_CONFIG=
