{
  "name": "business-os",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "install:check": "pnpm install --frozen-lockfile",
    "dev:api": "pnpm --filter @business-os/api-edge dev",
    "dev:worker": "pnpm --filter @business-os/worker-edge dev",
    "format": "prettier --write \"packages/**/*.{ts,json}\" \"tooling/**/*.{mjs,json}\" \"tests/**/*.{ts,json}\" \"*.{json,ts,mjs}\" pnpm-workspace.yaml",
    "format:check": "prettier --check \"packages/**/*.{ts,json}\" \"tooling/**/*.{mjs,json}\" \"tests/**/*.{ts,json}\" \"*.{json,ts,mjs}\" pnpm-workspace.yaml",
    "lint": "eslint .",
    "typecheck": "tsc --build --pretty false",
    "architecture:check": "node tooling/architecture-check.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:contract": "vitest run --project contract",
    "test:architecture": "vitest run --project architecture",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run --project e2e",
    "db:migrate": "node-pg-migrate up -d DATABASE_URL -m infrastructure/database/migrations/g003",
    "db:migrate:down": "node-pg-migrate down -d DATABASE_URL -m infrastructure/database/migrations/g003",
    "db:migrate:g004": "node-pg-migrate up -d DATABASE_URL -m 'infrastructure/database/migrations/**/*.cjs' --use-glob",
    "db:migrate:g004:down": "node-pg-migrate down -d DATABASE_URL -m 'infrastructure/database/migrations/**/*.cjs' --use-glob",
    "build": "tsc --build --pretty false",
    "validate:config": "node tooling/validate-config.mjs",
    "validate": "pnpm validate:config && pnpm format:check && pnpm lint && pnpm typecheck && pnpm architecture:check && pnpm test && pnpm build",
    "seed:first-screen": "node tooling/seed-first-screen.mjs",
    "dev:web": "node apps/web/server.mjs",
    "start:production": "node tooling/start-production.mjs",
    "healthcheck": "node tooling/healthcheck.mjs",
    "test:integration:first-screen": "vitest run tests/integration/platform/first-screen.test.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@types/node": "^22.10.5",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-import-x": "^4.17.1",
    "node-pg-migrate": "9.0.0",
    "pg": "8.23.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
